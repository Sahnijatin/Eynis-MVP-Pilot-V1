{
  "name": "@eynis/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "cross-env START_SERVER=true tsx src/server.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@eynis/shared": "0.1.0",
    "@prisma/client": "^6.5.0",
    "dotenv": "^16.6.1",
    "jose": "^6.1.0",
    "openai": "^6.37.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "cross-env": "^10.0.0",
    "prisma": "^6.5.0",
    "tsx": "^4.20.5",
    "typescript": "^6.0.0"
  }
}
