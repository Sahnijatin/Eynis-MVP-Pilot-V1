generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The tenant / organization — the billable, isolated account. Named `Tenant`
// (industry-neutral) but mapped to the existing `Hotel` table: model/code rename
// only, no data migration (docs/industry-agnostic-and-white-label-plan.md, A5).
// The code uses `tenantId` everywhere; the physical column stays `hotelId` via @map (no data migration).
model Tenant {
  id                    String                     @id @default(cuid())
  name                  String
  industry              String                     @default("hospitality")
  // White-label tier — how much a tenant may customise (E-9). Set by Eynis staff
  // via the internal provisioning console, NOT self-serve. "standard" = your
  // logo/colors on our product; "white_label" = full (hide "powered by", custom
  // font + extended tokens). Distinct from billing (License.plan).
  whitelabelTier        String                     @default("standard")
  timezone              String                     @default("Asia/Kolkata")
  slug                  String?                    @unique // <slug>.eynis.com (white-label subdomain)
  customDomain          String?                    @unique // e.g. app.tempus.com (CNAME → platform)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  users                 User[]
  guests                Contact[]
  stays                 Stay[]
  serviceRequests       ServiceRequest[]
  offerEvents           OfferEvent[]
  automationRules       AutomationRule[]
  automationExecutions  AutomationExecution[]
  nightAuditReports     NightAuditReport[]
  auditLogs             AuditLog[]
  transitions           ServiceRequestTransition[]
  connectorConfigs      ConnectorConfig[]
  connectorEvents       ConnectorEvent[]
  license               License?
  roles                 Role[]
  invitations           Invitation[]
  voiceCampaigns        VoiceCampaign[]
  leadSegments          LeadSegment[]
  messageTemplates      MessageTemplate[]
  sequences             Sequence[]
  sequenceEnrollments   SequenceEnrollment[]
  sequenceEvents        SequenceEvent[]
  campaignLeads         CampaignLead[]
  callRecords           CallRecord[]
  sentimentEvents       SentimentEvent[]
  whatsappConversations WhatsappConversation[]
  whatsappMessages      WhatsappMessage[]
  messageDeliveries     MessageDelivery[]
  doNotContacts         DoNotContact[]
  branding              TenantBranding?
  sendingDomain         SendingDomain?
  emailSuppressions     EmailSuppression[]
  inventoryItems        InventoryItem[]
  pipelines             Pipeline[]
  pipelineStages        Stage[]
  deals                 Deal[]
  dealTransitions       DealTransition[]
  companies             Company[]
  activities            Activity[]
  dealSuggestions       DealSuggestion[]
  reports               Report[]
  researchTemplates     ResearchTemplate[]
  researchRuns          ResearchRun[]
  researchSourceCaches  ResearchSourceCache[]
  researchSchedules     ResearchSchedule[]
  quotes                Quote[]
  quoteTemplates        QuoteTemplate[]

  @@map("Hotel")
}

// Inventory — the first non-hospitality vertical wired end-to-end (real
// persistence, not a frontend mock). Industry-neutral: an "item" works for F&B
// stock, manufacturing materials, retail SKUs, etc.
model InventoryItem {
  id           String   @id @default(cuid())
  tenantId     String   @map("hotelId")
  name         String
  category     String   @default("Other")
  stock        Float    @default(0)
  unit         String   @default("units")
  reorderLevel Float    @default(5)
  unitCostInr  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Per-tenant email suppression list. Populated by the Resend webhook on hard
// bounces and spam complaints (and manual adds). The email dispatcher skips any
// recipient on this list — the deliverability feedback loop that protects a
// tenant's sending reputation. Email-keyed counterpart to DoNotContact (phone).
model EmailSuppression {
  id        String   @id @default(cuid())
  tenantId  String   @map("hotelId")
  email     String // lowercased
  reason    String   @default("bounced") // bounced | complained | manual
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

// Per-tenant white-label branding. All fields optional — anything left null
// falls back to the tenant's industry defaults (see apps/web/lib/theme.ts), then
// to the Eynis defaults. This is the white-label override layer; the model is
// the white-label override layer for a tenant
// (see docs/industry-agnostic-and-white-label-plan.md).
model TenantBranding {
  id            String   @id @default(cuid())
  tenantId      String   @unique @map("hotelId")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandName     String? // overrides the sidebar title / wordmark
  tagline       String? // overrides the industry tagline (sidebar subtitle)
  logoUrl       String? // tenant logo (sidebar; later: emails, auth)
  faviconUrl    String?
  primaryColor  String? // overrides industry accentColor (primary brand color)
  accentColor   String? // secondary accent; defaults to primaryColor when null
  sidebarColor  String? // extended token (E-9): sidebar background; white_label tier
  fontFamily    String? // typography (E-9): CSS font-family stack; white_label tier
  customCss     String? // sanitised custom CSS (E-9); white_label tier only
  supportEmail  String?
  hidePoweredBy Boolean  @default(false) // white_label tier only (see whitelabelTier)
  brandEmails   Boolean  @default(true) // artifact flag (E-9): brand outbound emails
  brandReports  Boolean  @default(true) // artifact flag (E-9): brand reports/exports
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

// Per-tenant white-label email sending domain (E-9, Model B). Staff-provisioned
// via the internal console: we register the domain with the email provider, store
// the DNS records the tenant must publish, and poll verification. Outbound email
// only uses this identity once `status = "verified"` (else it falls back to the
// platform/connector identity so we never send from an unverified domain).
model SendingDomain {
  id             String    @id @default(cuid())
  tenantId       String    @unique @map("hotelId")
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain         String // e.g. "mail.acme.com"
  fromLocalPart  String    @default("notifications") // local part: <localPart>@<domain>
  fromName       String? // display name; falls back to brand/tenant name
  resendDomainId String? // provider (Resend) Domains API id
  status         String    @default("pending") // pending | verified | failed
  dnsRecords     String? // JSON array of { type, name, value, priority? } to publish
  lastCheckedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
}

model User {
  id                     String                     @id @default(cuid())
  tenantId               String                     @map("hotelId")
  fullName               String
  // An email is unique *within* a tenant, not globally — one identity (email /
  // Clerk account) can be a member of many workspaces, each with its own role.
  email                  String
  role                   String
  roleId                 String?
  isActive               Boolean                    @default(true)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  tenant                 Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  systemRole             Role?                      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  assignedRequests       ServiceRequest[]           @relation("assigned_requests")
  changedTransitions     ServiceRequestTransition[] @relation("transition_actor")
  ownedDeals             Deal[]                     @relation("deal_owner")
  changedDealTransitions DealTransition[]           @relation("deal_transition_actor")
  ownedContacts          Contact[]                  @relation("contact_owner")
  ownedCompanies         Company[]                  @relation("company_owner")
  activities             Activity[]                 @relation("activity_actor")
  reports                Report[]                   @relation("report_creator")
  researchTemplates      ResearchTemplate[]         @relation("research_template_creator")
  researchRuns           ResearchRun[]              @relation("research_run_creator")
  researchSchedules      ResearchSchedule[]         @relation("research_schedule_creator")

  @@unique([tenantId, email])
}

// The end-customer a tenant engages. Named `Contact` (industry-neutral) but
// mapped to the existing `Guest` table — model/code rename only, no data
// migration (see docs/industry-agnostic-and-white-label-plan.md, Plan A4).
model Contact {
  id              String           @id @default(cuid())
  tenantId        String           @map("hotelId")
  fullName        String
  phoneE164       String
  visitCount      Int              @default(0)
  // ── CRM hub fields (Increment B) ──────────────────────────────────────────
  email           String?
  companyId       String?
  ownerId         String?
  lifecycleStage  String           @default("lead") // subscriber|lead|mql|sql|opportunity|customer (tenant-configurable)
  leadStatus      String? // new|attempting|connected|qualified|disqualified
  leadScore       Int? // 0–100, AI/rules-derived (Increment C)
  source          String? // manual|campaign|connector|import
  tags            String[]         @default([])
  customFields    Json? // tenant-defined fields (see docs/crm-design.md §5.5)
  notes           String? // lightweight free-text; full activity timeline is Increment C
  lastActivityAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner           User?            @relation("contact_owner", fields: [ownerId], references: [id], onDelete: SetNull)
  stays           Stay[]
  serviceRequests ServiceRequest[]
  deals           Deal[]
  campaignLeads   CampaignLead[]
  activities      Activity[]
  quotes          Quote[]

  @@unique([tenantId, phoneE164])
  @@index([tenantId])
  @@index([companyId])
  @@map("Guest")
}

// A company / account (B2B). Optional: B2C tenants simply never create one.
// New table — physical column is `tenantId` directly (no legacy @@map).
model Company {
  id           String     @id @default(cuid())
  tenantId     String
  name         String
  domain       String?
  industry     String?
  size         String? // e.g. "1-10", "11-50", "51-200", "200+"
  ownerId      String?
  tags         String[]   @default([])
  customFields Json?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner        User?      @relation("company_owner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     Contact[]
  deals        Deal[]
  activities   Activity[]
  quotes       Quote[]

  @@index([tenantId])
}

// ── CRM: Activities timeline + AI suggestions (Increment C) ───────────────────

// A single timeline entry. Manual entries (note/task/meeting) are stored here;
// channel events (calls, WhatsApp, service requests) are projected in at read
// time (see core/crm/timeline.ts) — only manual + AI-authored rows persist here.
model Activity {
  id          String    @id @default(cuid())
  tenantId    String
  contactId   String?
  dealId      String?
  companyId   String?
  userId      String? // actor who logged it (null = system/AI)
  type        String // note | task | meeting | ai_score | ai_suggestion | system
  title       String
  body        String?
  direction   String? // inbound | outbound | null
  dueAt       DateTime? // tasks
  completedAt DateTime? // tasks
  status      String    @default("logged") // logged | open | done
  meta        Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?     @relation("activity_actor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([contactId])
  @@index([dealId])
  @@index([tenantId, status, dueAt])
}

// A pending AI proposal to move a deal to another stage. SAFE MODE: a human must
// accept (which performs the move) or dismiss — the AI never moves a deal itself.
model DealSuggestion {
  id               String    @id @default(cuid())
  tenantId         String
  dealId           String
  fromStageId      String?
  suggestedStageId String
  reason           String
  confidence       Int? // 0–100
  source           String    @default("ai") // ai | rule | research
  status           String    @default("pending") // pending | accepted | dismissed
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?
  resolvedById     String?
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal             Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([dealId])
}

model Stay {
  id         String   @id @default(cuid())
  tenantId   String   @map("hotelId")
  guestId    String
  roomNumber String
  checkInAt  DateTime
  checkOutAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest      Contact  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([tenantId, guestId])
}

model ServiceRequest {
  id               String                     @id @default(cuid())
  tenantId         String                     @map("hotelId")
  guestId          String
  category         String
  status           String
  source           String                     @default("whatsapp")
  summary          String
  assignedToUserId String?
  priority         String                     @default("normal")
  slaDueAt         DateTime?
  slaBreachedAt    DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  resolvedAt       DateTime?
  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest            Contact                    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  assignedTo       User?                      @relation("assigned_requests", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  transitions      ServiceRequestTransition[]

  @@index([tenantId, status])
}

model ServiceRequestTransition {
  id               String         @id @default(cuid())
  tenantId         String         @map("hotelId")
  serviceRequestId String
  fromStatus       String
  toStatus         String
  changedByUserId  String
  note             String?
  createdAt        DateTime       @default(now())
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  changedBy        User           @relation("transition_actor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, serviceRequestId, createdAt])
}

model OfferEvent {
  id          String   @id @default(cuid())
  tenantId    String   @map("hotelId")
  guestId     String?
  offerType   String
  channel     String   @default("whatsapp")
  status      String
  revenueInr  Int      @default(0)
  contextJson String
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model AutomationRule {
  id                   String                @id @default(cuid())
  tenantId             String                @map("hotelId")
  code                 String
  name                 String
  isActive             Boolean               @default(true)
  configJson           String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  automationExecutions AutomationExecution[]

  @@unique([tenantId, code])
}

model AutomationExecution {
  id              String         @id @default(cuid())
  tenantId        String         @map("hotelId")
  ruleId          String
  ruleCode        String
  triggerType     String
  triggerEntityId String?
  actionType      String
  actionResult    String
  resultDetail    String?
  executedAt      DateTime       @default(now())
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule            AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, triggerEntityId])
  @@index([tenantId, executedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("hotelId")
  actorRole  String
  action     String
  entityType String
  entityId   String?
  metadata   String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model ConnectorConfig {
  id           String   @id @default(cuid())
  tenantId     String   @map("hotelId")
  connectorKey String
  enabled      Boolean  @default(false)
  configJson   String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, connectorKey])
  @@index([tenantId, enabled])
}

model ConnectorEvent {
  id               String    @id @default(cuid())
  tenantId         String    @map("hotelId")
  connectorKey     String
  eventType        String    @default("inbound_message")
  guestPhone       String?
  guestId          String?
  guestName        String?
  rawPayload       String
  aiProvider       String?
  aiCategory       String?
  aiPriority       String?
  aiSummary        String?
  aiSentiment      String?
  aiRoutingHint    String?
  aiSlaMinutes     Int?
  serviceRequestId String?
  replyMessage     String?
  replySentAt      DateTime?
  replyStatus      String?
  createdAt        DateTime  @default(now())
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, connectorKey, createdAt])
  @@index([tenantId, createdAt])
}

model NightAuditReport {
  id          String   @id @default(cuid())
  tenantId    String   @map("hotelId")
  reportDate  String
  contentJson String
  provider    String   @default("claude")
  generatedAt DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reportDate])
  @@index([tenantId, generatedAt])
}

model License {
  id            String    @id @default(cuid())
  tenantId      String    @unique @map("hotelId")
  plan          String    @default("starter")
  maxSeats      Int       @default(5)
  renewsAt      DateTime?
  razorpaySubId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Role {
  id          String       @id @default(cuid())
  tenantId    String       @map("hotelId")
  key         String
  displayName String
  permissions String       @default("[]")
  isSystem    Boolean      @default(true)
  isCustom    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]
  invitations Invitation[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Invitation {
  id          String    @id @default(cuid())
  tenantId    String    @map("hotelId")
  email       String
  roleId      String
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id])

  @@index([tenantId, email])
  @@index([token])
}

// ── Voice Campaign module (Phase 2 data model) ──────────────────────────────
// Generic, industry-agnostic outbound AI voice calling. tenantId is the
// multi-tenant scope (= tenantId in the BRD). JSON payloads are stored as
// String to match the existing codebase convention (e.g. ConnectorConfig).

model VoiceCampaign {
  id                    String                 @id @default(cuid())
  tenantId              String                 @map("hotelId")
  name                  String
  status                String                 @default("draft") // draft | active | paused | completed
  channels              String                 @default("[\"voice\"]") // JSON array: voice | whatsapp | email
  // ── Voice channel (optional — only when "voice" in channels) ──
  scriptTemplate        String? // system prompt with {variable} placeholders
  outcomeTypes          String                 @default("[]") // JSON array of valid outcome labels
  followUpRules         String                 @default("{}") // JSON map of outcome -> [channels]
  calendlyLink          String?
  agentName             String? // name the AI introduces itself with; falls back to the hotel name
  // Voice A/B/N test arms live in the CampaignVariant child table (see `variants`).
  // ── WhatsApp channel (pre-approved template) ──
  whatsappContentSid    String? // legacy raw provider template id (Twilio Content SID / Meta template)
  whatsappTemplateId    String? // preferred: an approved MessageTemplate from the library
  whatsappTemplateBody  String? // approved text with {variable} placeholders (for preview)
  whatsappVariables     String                 @default("[]") // JSON ordered list of {variable} exprs for the template
  // ── WhatsApp two-way agent (configurable per campaign) ──
  whatsappAgentEnabled  Boolean                @default(false) // reply to inbound WhatsApp with the AI agent
  whatsappAgentPrompt   String? // operator-defined instructions: how the bot should respond to customers
  // ── Email channel ──
  emailSubjectTemplate  String? // {variable} placeholders
  emailBodyTemplate     String? // HTML, {variable} placeholders
  // ── Shared engine controls ──
  maxRetries            Int                    @default(2)
  retryDelayHours       Int                    @default(24)
  maxConcurrent         Int                    @default(5)
  spendCapCalls         Int? // auto-pause after this many total sends/dials
  defaultCountryCode    String                 @default("+91") // for phone normalisation
  // ── Scheduling / send windows (compliance: TRAI 9–9, TCPA 8–9) ──
  scheduledStartAt      DateTime? // do not contact before this instant
  sendWindowStartMin    Int? // allowed window start, minutes from local midnight (e.g. 540 = 09:00)
  sendWindowEndMin      Int? // allowed window end, minutes from local midnight (e.g. 1260 = 21:00)
  sendDays              String                 @default("[]") // JSON int[] of allowed weekdays (0=Sun); empty = all days
  sendTimeZone          String? // IANA tz for the window; falls back to the hotel's timezone
  // ── Targeting ──
  segmentId             String? // optional saved segment; when set, only matching leads are contacted
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  segment               LeadSegment?           @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  whatsappTemplate      MessageTemplate?       @relation(fields: [whatsappTemplateId], references: [id], onDelete: SetNull)
  leads                 CampaignLead[]
  calls                 CallRecord[]
  deliveries            MessageDelivery[]
  whatsappConversations WhatsappConversation[]
  variants              CampaignVariant[]

  @@index([tenantId, status])
}

// One A/B/N test arm of a voice campaign. A campaign has 1..N variants (one = no
// test). Leads/calls reference a variant by its `key` (stored in abVariant), and
// leads are distributed across variants by `weight`. Replaces the fixed A/B
// columns on VoiceCampaign.
model CampaignVariant {
  id              String        @id @default(cuid())
  campaignId      String
  tenantId        String        @map("hotelId") // scalar for scoping; cascade flows via campaign
  key             String // stable per-campaign key: A, B, C, … (matches CampaignLead/CallRecord.abVariant)
  label           String // human label, e.g. "Enthusiastic"
  voice           String? // ElevenLabs voice name
  persona         String? // persona label fed to the assistant
  scriptOverride  String? // optional per-variant system prompt; falls back to campaign.scriptTemplate
  vapiAssistantId String? // provisioned on activation
  weight          Int           @default(1) // relative share for lead distribution
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  campaign        VoiceCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, key])
  @@index([campaignId])
}

// ── Drip automation: multi-step sequences ──────────────────────────────────
// A Sequence is an ordered list of Steps (delay → send on a channel). Leads are
// enrolled; a runner advances each enrollment step-by-step and exits early on
// configured conditions (reply / opt-out / booking). Reuses the ChannelSender
// registry + the shared compliance guard.
model Sequence {
  id          String               @id @default(cuid())
  tenantId    String               @map("hotelId")
  name        String
  status      String               @default("draft") // draft | active | archived
  exitOn      String               @default("[\"opted_out\",\"replied\"]") // JSON string[] of exit conditions
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]
  events      SequenceEvent[]

  @@index([tenantId, status])
}

model SequenceStep {
  id                   String           @id @default(cuid())
  sequenceId           String
  order                Int // 0-based position
  waitMinutes          Int              @default(0) // delay before this step (from enrollment for step 0, else from the previous step's run)
  channel              String // whatsapp | email
  whatsappContentSid   String? // legacy raw template id
  whatsappTemplateId   String? // preferred: an approved MessageTemplate from the library
  whatsappTemplateBody String?
  whatsappVariables    String           @default("[]") // JSON ordered list of {variable} exprs
  emailSubject         String?
  emailBody            String?
  sequence             Sequence         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  whatsappTemplate     MessageTemplate? @relation(fields: [whatsappTemplateId], references: [id], onDelete: SetNull)

  @@unique([sequenceId, order])
  @@index([sequenceId])
}

model SequenceEnrollment {
  id               String          @id @default(cuid())
  sequenceId       String
  tenantId         String          @map("hotelId")
  leadId           String
  status           String          @default("active") // active | completed | stopped
  currentStepOrder Int             @default(0)
  nextRunAt        DateTime // when the current step becomes due
  stoppedReason    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sequence         Sequence        @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead             CampaignLead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  events           SequenceEvent[]

  @@unique([sequenceId, leadId])
  @@index([status, nextRunAt])
  @@index([tenantId])
}

model SequenceEvent {
  id           String             @id @default(cuid())
  tenantId     String             @map("hotelId")
  sequenceId   String
  enrollmentId String
  leadId       String
  stepOrder    Int
  channel      String
  status       String // sent | failed | skipped | stopped
  error        String?
  createdAt    DateTime           @default(now())
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sequence     Sequence           @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  enrollment   SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([sequenceId, createdAt])
  @@index([enrollmentId])
}

// Reusable message template library with approval-status tracking. WhatsApp
// templates must be approved by Meta/Twilio before use; this records that
// lifecycle (draft → submitted → approved/rejected) and the approved provider
// id (Content SID) so campaigns/sequences can pick an approved template instead
// of pasting a raw SID. Email templates need no approval.
model MessageTemplate {
  id                 String          @id @default(cuid())
  tenantId           String          @map("hotelId")
  name               String
  channel            String // whatsapp | email
  category           String          @default("marketing") // marketing | utility | authentication
  language           String          @default("en")
  subject            String? // email only
  body               String // text/HTML with {variable} or {{1}} placeholders
  variables          String          @default("[]") // JSON ordered list of {variable} exprs
  status             String          @default("draft") // draft | submitted | approved | rejected
  providerTemplateId String? // approved Content SID / Meta template id
  rejectionReason    String?
  submittedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns          VoiceCampaign[]
  sequenceSteps      SequenceStep[]

  @@index([tenantId, channel, status])
}

// Saved, tenant-wide audience filter. `rules` is a JSON SegmentRules object
// (see core/campaigns/segments.ts) compiled to a Prisma where-clause at query
// time. A campaign can target a segment so only matching leads are contacted.
model LeadSegment {
  id        String          @id @default(cuid())
  tenantId  String          @map("hotelId")
  name      String
  rules     String          @default("{}") // JSON SegmentRules
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns VoiceCampaign[]

  @@index([tenantId])
}

model CampaignLead {
  id                    String                 @id @default(cuid())
  campaignId            String
  tenantId              String                 @map("hotelId")
  firstName             String
  lastName              String?
  phone                 String? // E.164 normalised; nullable to support GDPR erasure
  email                 String?
  company               String?
  jobTitle              String?
  rawData               String                 @default("{}") // original CSV row JSON -> {lead.custom.*}
  tags                  String[]               @default([]) // free-form labels for segmentation
  abVariant             String? // A | B, assigned on first dial
  status                String                 @default("pending") // pending|calling|called|completed|failed|opted_out
  callAttempts          Int                    @default(0)
  nextCallAt            DateTime? // set on retry scheduling
  consent               Boolean                @default(false) // Phase 1 consent fields
  consentSource         String? // ConsentSource (@eynis/shared)
  consentAt             DateTime?
  optedOut              Boolean                @default(false) // tenant-wide opt-out exclusion flag
  contactId             String? // links to the durable Contact hub (Increment B)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign              VoiceCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact               Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
  calls                 CallRecord[]
  deliveries            MessageDelivery[]
  whatsappConversations WhatsappConversation[]
  sequenceEnrollments   SequenceEnrollment[]

  // Dedupe phone within a campaign. NOTE: Postgres treats NULLs as distinct, so
  // this does NOT dedupe null-phone rows — acceptable because active leads always
  // carry a non-null E.164 phone (enforced at import in csv-import.ts), and the
  // only null-phone rows are GDPR-erased leads, which are inert (never dialled).
  @@unique([campaignId, phone])
  @@index([campaignId, status])
  @@index([tenantId, phone]) // tenant-wide opt-out lookup by phone
  @@index([contactId])
}

model CallRecord {
  id              String           @id @default(cuid())
  campaignId      String
  leadId          String
  tenantId        String           @map("hotelId")
  vapiCallId      String?          @unique // Vapi identifier, matches incoming webhook
  abVariant       String // A | B
  status          String           @default("initiated") // initiated | in_progress | ended | failed
  outcome         String? // value from campaign.outcomeTypes
  error           String? // failure detail (initiation error, stuck_timeout, …)
  durationSeconds Int?
  transcript      String?
  aiSummary       String?
  sentiment       String? // positive | neutral | negative (final aggregate)
  keyPoints       String           @default("[]") // JSON array
  whatsappSent    Boolean          @default(false)
  emailSent       Boolean          @default(false)
  meetingBooked   Boolean          @default(false)
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime         @default(now())
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign        VoiceCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead            CampaignLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sentimentEvents SentimentEvent[]

  @@index([campaignId, status])
  @@index([tenantId, createdAt])
}

// Real-time sentiment timeline — one row per analysed utterance (call) or
// message (WhatsApp). Powers the live mood meter during a call.
model SentimentEvent {
  id             String                @id @default(cuid())
  tenantId       String                @map("hotelId")
  callRecordId   String?
  conversationId String?
  speaker        String // agent | customer
  text           String // analysed snippet
  sentiment      String // positive | neutral | negative
  score          Float? // rolling numeric score
  createdAt      DateTime              @default(now())
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  callRecord     CallRecord?           @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  conversation   WhatsappConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([callRecordId, createdAt])
  @@index([conversationId, createdAt])
}

// Stateful two-way WhatsApp conversation tied to a campaign lead.
model WhatsappConversation {
  id              String            @id @default(cuid())
  tenantId        String            @map("hotelId")
  campaignId      String
  leadId          String
  state           String            @default("open") // open | awaiting_reply | booked | closed | opted_out
  lastMessageAt   DateTime?
  threadSummary   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign        VoiceCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead            CampaignLead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages        WhatsappMessage[]
  sentimentEvents SentimentEvent[]

  @@index([tenantId, state])
  @@index([leadId])
}

model WhatsappMessage {
  id             String               @id @default(cuid())
  tenantId       String               @map("hotelId")
  conversationId String
  direction      String // in | out
  body           String
  providerId     String? // provider message id (inbound dedupe / outbound tracking)
  sentiment      String? // positive | neutral | negative
  score          Float?
  createdAt      DateTime             @default(now())
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Per-lead outbound message record for the WhatsApp + email channels (the
// non-voice analogue of CallRecord). One row per send attempt.
model MessageDelivery {
  id              String        @id @default(cuid())
  tenantId        String        @map("hotelId")
  campaignId      String
  leadId          String
  channel         String // whatsapp | email
  status          String        @default("queued") // queued | sent | failed | delivered | replied
  renderedSubject String? // email only
  renderedBody    String? // what was sent (audit + UI preview)
  providerId      String? // provider message id
  error           String?
  sentAt          DateTime?
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign        VoiceCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead            CampaignLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([campaignId, channel, status])
  @@index([tenantId, createdAt])
}

// Durable, tenant-wide do-not-contact suppression list. Survives lead/campaign
// deletion (unlike the optedOut flag on a lead), so an opt-out is permanent
// across all future campaigns and channels (compliance review finding #3).
model DoNotContact {
  id        String   @id @default(cuid())
  tenantId  String   @map("hotelId")
  phone     String // E.164
  reason    String   @default("opt_out") // opt_out | dnd | manual | gdpr_erasure
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phone])
  @@index([tenantId])
}

// ── CRM: Pipelines, Deals & Forecasting (Increment A) ─────────────────────────
// Industry-neutral sales/relationship pipeline. These are NEW tables, so the
// physical column is `tenantId` directly (no legacy @@map shim). Every row is
// tenant-scoped; labels/stages/probabilities are per-tenant configurable
// (white-label). See docs/crm-design.md §12 and docs/crm-implementation-roadmap.md.

// A configurable funnel a Deal travels through. A tenant can have several;
// exactly one is the default (used when a deal is created without a pipeline).
model Pipeline {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isDefault Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages    Stage[]
  deals     Deal[]

  @@index([tenantId])
}

// A single step in a pipeline. `probability` (0–100) drives the weighted
// forecast. `isWon`/`isLost` mark the terminal stages that close a deal.
model Stage {
  id          String   @id @default(cuid())
  tenantId    String
  pipelineId  String
  name        String
  order       Int
  probability Int      @default(0) // 0–100; weight applied to deal value in the forecast
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]

  @@index([tenantId])
  @@index([pipelineId])
}

// An opportunity / revenue motion. Optionally linked to a Contact (the person)
// and an owner (a User). `value` is money in `currency` (default INR).
model Deal {
  id              String           @id @default(cuid())
  tenantId        String
  title           String
  value           Decimal?         @db.Decimal(14, 2)
  currency        String           @default("INR")
  pipelineId      String
  stageId         String
  contactId       String?
  companyId       String?
  ownerId         String?
  status          String           @default("open") // open | won | lost
  expectedCloseAt DateTime?
  closedAt        DateTime?
  lostReason      String?
  source          String? // manual | campaign | connector | import
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline        Pipeline         @relation(fields: [pipelineId], references: [id])
  stage           Stage            @relation(fields: [stageId], references: [id])
  contact         Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner           User?            @relation("deal_owner", fields: [ownerId], references: [id], onDelete: SetNull)
  transitions     DealTransition[]
  activities      Activity[]
  suggestions     DealSuggestion[]
  quotes          Quote[]

  @@index([tenantId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([contactId])
  @@index([companyId])
}

// Stage-change history for a deal. Powers the activity trail now and velocity /
// forecast-accuracy reporting later (Increment C).
model DealTransition {
  id          String   @id @default(cuid())
  tenantId    String
  dealId      String
  fromStageId String?
  toStageId   String
  changedById String?
  note        String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  changedBy   User?    @relation("deal_transition_actor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([dealId])
}

// User-built saved report (E-16). The query is stored as a definition JSON
// (source, columns, filters, group-by, sort, visualization) and executed against
// tenant-scoped data at run time. `shared=false` → visible only to the creator;
// `shared=true` → visible to any tenant member with the reports permission.
model Report {
  id             String        @id @default(cuid())
  tenantId       String        @map("hotelId")
  name           String
  description    String?
  source         String // data-source key: service_requests | deals | contacts
  definitionJson String // JSON: { columns, filters, dateField, from, to, groupBy, sort, visualization }
  shared         Boolean       @default(false)
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy      User?         @relation("report_creator", fields: [createdById], references: [id], onDelete: SetNull)
  shares         ReportShare[]

  @@index([tenantId])
}

// Per-report sharing ACL (E-16 Phase B). Grants visibility beyond the
// all-or-nothing tenant-wide `Report.shared` flag: a report can be shared with
// specific users (principalId = User.id) or everyone holding a role
// (principalId = Role.key). Only the report's creator manages these grants, and
// a grant confers read/run/export only — never edit/delete. Tenant-scoped, and
// cascaded away when the report (or its tenant) is deleted.
model ReportShare {
  id            String   @id @default(cuid())
  tenantId      String   @map("hotelId")
  reportId      String
  principalType String // "user" | "role"
  principalId   String // User.id (when "user") or Role.key (when "role")
  createdAt     DateTime @default(now())
  report        Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, principalType, principalId])
  @@index([reportId])
  @@index([tenantId, principalType, principalId])
  @@map("ReportShare")
}

// ── Research Studio (RS-1) ───────────────────────────────────────────────────
// A configurable, tenant-owned research-and-report capability. A ResearchTemplate
// is a saved *definition* of what to research (subject + inputs), which sources to
// gather from, and how the report is structured (sections). It is industry-agnostic
// and not limited to marketing — "marketing audit" is just one saved template.
// All JSON columns are app-validated against an allow-list before use.
model ResearchTemplate {
  id           String        @id @default(cuid())
  tenantId     String        @map("hotelId")
  name         String
  description  String?
  subjectType  String        @default("freeform") // deal | contact | company | freeform
  inputsJson   String // JSON: [{ key, label, prefillFrom?, required? }]
  sourcesJson  String // JSON: { webSearch:{enabled,queries[]}, crawl:{enabled,seeds[],maxPages}, pagespeed:{enabled} }
  sectionsJson String // JSON: [{ id, title, prompt, outputs:["text"|"table"|"chart"|"score"], weight? }]
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("research_template_creator", fields: [createdById], references: [id], onDelete: SetNull)
  runs         ResearchRun[]

  @@index([tenantId])
}

// One execution of a template against a subject. The template definition is
// snapshotted (templateSnapshot) so editing a template never mutates past reports.
// subjectId is a loose reference (deal/contact/company id) — no FK, because the
// subject can be any of three entity types (or free-form).
model ResearchRun {
  id               String            @id @default(cuid())
  tenantId         String            @map("hotelId")
  templateId       String?
  templateName     String
  templateSnapshot String // JSON snapshot of the template def used for this run
  subjectType      String            @default("freeform")
  subjectId        String? // loose ref to a deal/contact/company (no FK)
  subjectLabel     String?
  inputsJson       String // JSON of resolved input values
  status           String            @default("queued") // queued|gathering|synthesizing|validating|ready|failed
  progress         Int               @default(0) // 0-100 for the progress UI
  stage            String? // human-readable current stage
  gatheredJson     String? // raw gathered evidence (sources, crawl text, metrics)
  resultJson       String? // structured { sections:[...] }
  score            Int? // overall 0-100 score, if the template defines one
  usageJson        String? // { tokensIn, tokensOut, llmCalls, sourcesFetched }
  error            String?
  shared           Boolean           @default(false) // tenant-wide visibility (mirrors Report.shared)
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template         ResearchTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy        User?             @relation("research_run_creator", fields: [createdById], references: [id], onDelete: SetNull)
  shares           ResearchShare[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, subjectType, subjectId])
}

// Per-tenant crawl cache so repeat runs don't re-fetch the same URL (cost/latency).
model ResearchSourceCache {
  id        String   @id @default(cuid())
  tenantId  String   @map("hotelId")
  urlHash   String // sha256 of the normalized URL
  url       String
  content   String // extracted readable text (markdown-ish)
  fetchedAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, urlHash])
  @@index([tenantId])
}

// Per-run sharing ACL — mirrors ReportShare. A grant confers read/export only.
model ResearchShare {
  id            String      @id @default(cuid())
  tenantId      String      @map("hotelId")
  runId         String
  principalType String // "user" | "role"
  principalId   String // User.id or Role.key
  createdAt     DateTime    @default(now())
  run           ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, principalType, principalId])
  @@index([runId])
  @@index([tenantId, principalType, principalId])
}

// Scheduled / recurring re-research (RS-4). A schedule re-enqueues a research run
// on a cadence (daily|weekly|monthly). It snapshots the run parameters (template
// + subject + inputs) so it stays valid even if the originating run is deleted;
// re-running is therefore the same primitive as POST /research/runs/:id/rerun,
// just driven by the clock. The schedule worker claims a due row atomically
// (advances nextRunAt) before enqueueing, so a crash or overlapping cycle can
// never double-run it.
model ResearchSchedule {
  id               String    @id @default(cuid())
  tenantId         String    @map("hotelId")
  templateId       String? // null for built-in or deleted templates
  templateName     String
  templateSnapshot String // JSON snapshot of the template def to run
  subjectType      String    @default("freeform")
  subjectId        String?
  subjectLabel     String?
  inputsJson       String // JSON of resolved input values
  cadence          String    @default("weekly") // daily | weekly | monthly
  isActive         Boolean   @default(true)
  nextRunAt        DateTime
  lastRunAt        DateTime?
  lastRunId        String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy        User?     @relation("research_schedule_creator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([isActive, nextRunAt])
}

// ── Quoting + component-based costing engine (furniture & general manufacturing) ─
// Industry-neutral: a quote decomposes into line items (components), each costed by
// dimension × material rate + labor, then rolled up with overhead + margin. New
// tables use a physical `tenantId` column (no legacy @@map). All money is stored as
// integer paise so dimension×rate math never drifts; convert to rupees only at the
// Deal.value boundary. A sent quote is immutable: line rates are snapshotted at
// add-time (never re-read from InventoryItem) and edits are rejected once status
// leaves `draft`. See docs/project-review + the Tempus quoting plan.

// A reusable preset ("Dining Table", "Office Desk") that seeds a quote with its
// default components and pricing knobs.
model QuoteTemplate {
  id             String              @id @default(cuid())
  tenantId       String
  name           String
  category       String              @default("Furniture")
  description    String?
  isActive       Boolean             @default(true)
  overheadPct    Float               @default(15) // % of direct cost
  marginPct      Float               @default(40) // target markup on loaded cost
  marginFloorPct Float               @default(30) // enforced gross-margin floor
  laborRatePaise Int                 @default(0) // default labor rate per hour
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  components     TemplateComponent[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

// A default component of a template. `inventoryItemId` is provenance only — it is
// resolved to a frozen rate snapshot when a quote line is created from it.
model TemplateComponent {
  id               String        @id @default(cuid())
  templateId       String
  tenantId         String
  name             String // "Table top", "Leg", "Apron", "Hardware kit"
  kind             String        @default("material") // material | labor | hardware | finish | other
  costBasis        String        @default("area") // area | length | perimeter | volume | fixed | hours
  inventoryItemId  String? // provenance; rate is snapshotted, not linked at cost time
  materialUnit     String        @default("sqft") // sqft | rft | cft | unit | hour (display)
  defaultRatePaise Int           @default(0) // used when no inventory link
  defaultLengthMm  Int?
  defaultWidthMm   Int?
  defaultHeightMm  Int?
  defaultQuantity  Float         @default(1)
  wastagePct       Float         @default(0)
  laborHours       Float         @default(0)
  sortOrder        Int           @default(0)
  template         QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// A quote. Rollup totals are STORED (recomputed by core/quotes/costing on each draft
// write) so reads and the PDF are a pure read of frozen integers.
model Quote {
  id                String          @id @default(cuid())
  tenantId          String
  number            String // "Q-2026-0001", unique per tenant
  title             String
  status            String          @default("draft") // draft | sent | accepted | rejected | expired
  contactId         String?
  companyId         String?
  dealId            String?
  templateId        String? // provenance of the preset that seeded it
  currency          String          @default("INR")
  overheadPct       Float           @default(15)
  marginPct         Float           @default(40)
  marginFloorPct    Float           @default(30)
  discountPaise     Int             @default(0)
  materialCostPaise Int             @default(0)
  laborCostPaise    Int             @default(0)
  overheadPaise     Int             @default(0)
  subtotalCostPaise Int             @default(0) // material + labor + overhead (loaded cost)
  marginPaise       Int             @default(0)
  totalPaise        Int             @default(0) // selling price
  marginPctActual   Float           @default(0) // margin / total * 100 (gross margin)
  notes             String?
  terms             String?
  validUntil        DateTime?
  sentAt            DateTime?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  rejectedReason    String?
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact           Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company           Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal              Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  lineItems         QuoteLineItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([dealId])
  @@index([contactId])
}

// One component line, grouped by `groupName` (the piece it rolls up to). Rate fields
// are a frozen snapshot; `inventoryItemId` is drill-back provenance only.
model QuoteLineItem {
  id                String  @id @default(cuid())
  quoteId           String
  tenantId          String
  groupName         String  @default("General") // the piece this component belongs to
  name              String // "Table top"
  kind              String  @default("material") // material | labor | hardware | finish | other
  costBasis         String  @default("area")
  lengthMm          Int?
  widthMm           Int?
  heightMm          Int?
  quantity          Float   @default(1)
  inventoryItemId   String? // provenance/drill-back only
  materialUnit      String  @default("sqft")
  unitRatePaise     Int     @default(0) // frozen material rate at add-time
  wastagePct        Float   @default(0)
  laborHours        Float   @default(0)
  laborRatePaise    Int     @default(0)
  computedQty       Float   @default(0) // derived from costBasis + dims
  materialCostPaise Int     @default(0)
  laborCostPaise    Int     @default(0)
  lineCostPaise     Int     @default(0) // material + labor (pre overhead/margin)
  sortOrder         Int     @default(0)
  quote             Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}
