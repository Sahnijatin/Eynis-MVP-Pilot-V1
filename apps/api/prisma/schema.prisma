generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hotel {
  id                    String                     @id @default(cuid())
  name                  String
  industry              String                     @default("hospitality")
  timezone              String                     @default("Asia/Kolkata")
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  users                 User[]
  guests                Guest[]
  stays                 Stay[]
  serviceRequests       ServiceRequest[]
  offerEvents           OfferEvent[]
  automationRules       AutomationRule[]
  automationExecutions  AutomationExecution[]
  nightAuditReports     NightAuditReport[]
  auditLogs             AuditLog[]
  transitions           ServiceRequestTransition[]
  connectorConfigs      ConnectorConfig[]
  connectorEvents       ConnectorEvent[]
  license               License?
  roles                 Role[]
  invitations           Invitation[]
  voiceCampaigns        VoiceCampaign[]
  campaignLeads         CampaignLead[]
  callRecords           CallRecord[]
  sentimentEvents       SentimentEvent[]
  whatsappConversations WhatsappConversation[]
  whatsappMessages      WhatsappMessage[]
}

model User {
  id                 String                     @id @default(cuid())
  hotelId            String
  fullName           String
  email              String                     @unique
  role               String
  roleId             String?
  isActive           Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  hotel              Hotel                      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  systemRole         Role?                      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  assignedRequests   ServiceRequest[]           @relation("assigned_requests")
  changedTransitions ServiceRequestTransition[] @relation("transition_actor")
}

model Guest {
  id              String           @id @default(cuid())
  hotelId         String
  fullName        String
  phoneE164       String
  visitCount      Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  hotel           Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  stays           Stay[]
  serviceRequests ServiceRequest[]

  @@index([hotelId])
}

model Stay {
  id         String   @id @default(cuid())
  hotelId    String
  guestId    String
  roomNumber String
  checkInAt  DateTime
  checkOutAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([hotelId, guestId])
}

model ServiceRequest {
  id               String                     @id @default(cuid())
  hotelId          String
  guestId          String
  category         String
  status           String
  source           String                     @default("whatsapp")
  summary          String
  assignedToUserId String?
  priority         String                     @default("normal")
  slaDueAt         DateTime?
  slaBreachedAt    DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  resolvedAt       DateTime?
  hotel            Hotel                      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest            Guest                      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  assignedTo       User?                      @relation("assigned_requests", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  transitions      ServiceRequestTransition[]

  @@index([hotelId, status])
}

model ServiceRequestTransition {
  id               String         @id @default(cuid())
  hotelId          String
  serviceRequestId String
  fromStatus       String
  toStatus         String
  changedByUserId  String
  note             String?
  createdAt        DateTime       @default(now())
  hotel            Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  changedBy        User           @relation("transition_actor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([hotelId, serviceRequestId, createdAt])
}

model OfferEvent {
  id          String   @id @default(cuid())
  hotelId     String
  guestId     String?
  offerType   String
  channel     String   @default("whatsapp")
  status      String
  revenueInr  Int      @default(0)
  contextJson String
  createdAt   DateTime @default(now())
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, status])
}

model AutomationRule {
  id                   String                @id @default(cuid())
  hotelId              String
  code                 String
  name                 String
  isActive             Boolean               @default(true)
  configJson           String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  hotel                Hotel                 @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  automationExecutions AutomationExecution[]

  @@unique([hotelId, code])
}

model AutomationExecution {
  id              String         @id @default(cuid())
  hotelId         String
  ruleId          String
  ruleCode        String
  triggerType     String
  triggerEntityId String?
  actionType      String
  actionResult    String
  resultDetail    String?
  executedAt      DateTime       @default(now())
  hotel           Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rule            AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([hotelId, executedAt])
  @@index([ruleId, triggerEntityId])
}

model AuditLog {
  id         String   @id @default(cuid())
  hotelId    String
  actorRole  String
  action     String
  entityType String
  entityId   String?
  metadata   String
  createdAt  DateTime @default(now())
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, createdAt])
}

model ConnectorConfig {
  id           String   @id @default(cuid())
  hotelId      String
  connectorKey String
  enabled      Boolean  @default(false)
  configJson   String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, connectorKey])
  @@index([hotelId, enabled])
}

model ConnectorEvent {
  id               String    @id @default(cuid())
  hotelId          String
  connectorKey     String
  eventType        String    @default("inbound_message")
  guestPhone       String?
  guestId          String?
  guestName        String?
  rawPayload       String
  aiProvider       String?
  aiCategory       String?
  aiPriority       String?
  aiSummary        String?
  aiSentiment      String?
  aiRoutingHint    String?
  aiSlaMinutes     Int?
  serviceRequestId String?
  replyMessage     String?
  replySentAt      DateTime?
  replyStatus      String?
  createdAt        DateTime  @default(now())
  hotel            Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, connectorKey, createdAt])
  @@index([hotelId, createdAt])
}

model NightAuditReport {
  id          String   @id @default(cuid())
  hotelId     String
  reportDate  String
  contentJson String
  provider    String   @default("claude")
  generatedAt DateTime @default(now())
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, reportDate])
  @@index([hotelId, generatedAt])
}

model License {
  id            String    @id @default(cuid())
  hotelId       String    @unique
  plan          String    @default("starter")
  maxSeats      Int       @default(5)
  renewsAt      DateTime?
  razorpaySubId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  hotel         Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Role {
  id          String       @id @default(cuid())
  hotelId     String
  key         String
  displayName String
  permissions String       @default("[]")
  isSystem    Boolean      @default(true)
  isCustom    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  hotel       Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  users       User[]
  invitations Invitation[]

  @@unique([hotelId, key])
  @@index([hotelId])
}

model Invitation {
  id          String    @id @default(cuid())
  hotelId     String
  email       String
  roleId      String
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime  @default(now())
  hotel       Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id])

  @@index([hotelId, email])
  @@index([token])
}

// ── Voice Campaign module (Phase 2 data model) ──────────────────────────────
// Generic, industry-agnostic outbound AI voice calling. hotelId is the
// multi-tenant scope (= tenantId in the BRD). JSON payloads are stored as
// String to match the existing codebase convention (e.g. ConnectorConfig).

model VoiceCampaign {
  id                    String                 @id @default(cuid())
  hotelId               String
  name                  String
  status                String                 @default("draft") // draft | active | paused | completed
  scriptTemplate        String // system prompt with {variable} placeholders
  outcomeTypes          String                 @default("[]") // JSON array of valid outcome labels
  followUpRules         String                 @default("{}") // JSON map of outcome -> [channels]
  calendlyLink          String?
  agentName             String? // name the AI introduces itself with; falls back to the hotel name
  voiceA                String // ElevenLabs voice name for variant A
  voiceB                String // ElevenLabs voice name for variant B
  personaA              String // label, e.g. "Enthusiastic"
  personaB              String // label, e.g. "Sophisticated"
  vapiAssistantIdA      String? // provisioned on activation
  vapiAssistantIdB      String?
  maxRetries            Int                    @default(2)
  retryDelayHours       Int                    @default(24)
  maxConcurrent         Int                    @default(5)
  spendCapCalls         Int? // auto-pause after this many total dials
  defaultCountryCode    String                 @default("+91") // for phone normalisation
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  hotel                 Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  leads                 CampaignLead[]
  calls                 CallRecord[]
  whatsappConversations WhatsappConversation[]

  @@index([hotelId, status])
}

model CampaignLead {
  id                    String                 @id @default(cuid())
  campaignId            String
  hotelId               String
  firstName             String
  lastName              String?
  phone                 String? // E.164 normalised; nullable to support GDPR erasure
  email                 String?
  company               String?
  jobTitle              String?
  rawData               String                 @default("{}") // original CSV row JSON -> {lead.custom.*}
  abVariant             String? // A | B, assigned on first dial
  status                String                 @default("pending") // pending|calling|called|completed|failed|opted_out
  callAttempts          Int                    @default(0)
  nextCallAt            DateTime? // set on retry scheduling
  consent               Boolean                @default(false) // Phase 1 consent fields
  consentSource         String? // ConsentSource (@eynis/shared)
  consentAt             DateTime?
  optedOut              Boolean                @default(false) // tenant-wide opt-out exclusion flag
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  hotel                 Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  campaign              VoiceCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  calls                 CallRecord[]
  whatsappConversations WhatsappConversation[]

  // Dedupe phone within a campaign. NOTE: Postgres treats NULLs as distinct, so
  // this does NOT dedupe null-phone rows — acceptable because active leads always
  // carry a non-null E.164 phone (enforced at import in csv-import.ts), and the
  // only null-phone rows are GDPR-erased leads, which are inert (never dialled).
  @@unique([campaignId, phone])
  @@index([campaignId, status])
  @@index([hotelId, phone]) // tenant-wide opt-out lookup by phone
}

model CallRecord {
  id              String           @id @default(cuid())
  campaignId      String
  leadId          String
  hotelId         String
  vapiCallId      String?          @unique // Vapi identifier, matches incoming webhook
  abVariant       String // A | B
  status          String           @default("initiated") // initiated | in_progress | ended | failed
  outcome         String? // value from campaign.outcomeTypes
  durationSeconds Int?
  transcript      String?
  aiSummary       String?
  sentiment       String? // positive | neutral | negative (final aggregate)
  keyPoints       String           @default("[]") // JSON array
  whatsappSent    Boolean          @default(false)
  emailSent       Boolean          @default(false)
  meetingBooked   Boolean          @default(false)
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime         @default(now())
  hotel           Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  campaign        VoiceCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead            CampaignLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sentimentEvents SentimentEvent[]

  @@index([campaignId, status])
  @@index([hotelId, createdAt])
}

// Real-time sentiment timeline — one row per analysed utterance (call) or
// message (WhatsApp). Powers the live mood meter during a call.
model SentimentEvent {
  id             String                @id @default(cuid())
  hotelId        String
  callRecordId   String?
  conversationId String?
  speaker        String // agent | customer
  text           String // analysed snippet
  sentiment      String // positive | neutral | negative
  score          Float? // rolling numeric score
  createdAt      DateTime              @default(now())
  hotel          Hotel                 @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  callRecord     CallRecord?           @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  conversation   WhatsappConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([callRecordId, createdAt])
  @@index([conversationId, createdAt])
}

// Stateful two-way WhatsApp conversation tied to a campaign lead.
model WhatsappConversation {
  id              String            @id @default(cuid())
  hotelId         String
  campaignId      String
  leadId          String
  state           String            @default("open") // open | awaiting_reply | booked | closed | opted_out
  lastMessageAt   DateTime?
  threadSummary   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  hotel           Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  campaign        VoiceCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead            CampaignLead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages        WhatsappMessage[]
  sentimentEvents SentimentEvent[]

  @@index([hotelId, state])
  @@index([leadId])
}

model WhatsappMessage {
  id             String               @id @default(cuid())
  hotelId        String
  conversationId String
  direction      String // in | out
  body           String
  sentiment      String? // positive | neutral | negative
  score          Float?
  createdAt      DateTime             @default(now())
  hotel          Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
