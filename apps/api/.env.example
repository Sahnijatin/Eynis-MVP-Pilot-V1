# ─────────────────────────────────────────────────────────────────────────────
# @eynis/api environment
# Copy to apps/api/.env and fill in real values. .env is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Core
# PostgreSQL connection string (Render Postgres, Neon, Supabase, local, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
JWT_SECRET="replace-with-long-random-secret"
# AES-256 key for connector secrets at rest (32-byte hex/base64, or any string —
# hashed to 32 bytes). REQUIRED in production (startup fails without it); when
# unset in dev, secrets are stored in plaintext exactly as before.
SECRETS_ENC_KEY=""
# Internal provisioning console (E-8): staff-only super-admin secret (16+ chars),
# separate from tenant JWTs/RBAC. Required as a bearer on /internal/* routes that
# set a tenant's industry. Must match the web's PLATFORM_ADMIN_SECRET. Leave unset
# to disable the internal routes entirely (fail closed).
PLATFORM_ADMIN_SECRET=""
PORT="4000"
# Set START_SERVER=true to actually listen (tests import buildServer without it).
START_SERVER="true"
# Base URL of the web app — used to build invite links (POST /team/invitations).
EYNIS_WEB_BASE_URL="http://localhost:3000"

# White-label (E-9): the platform's own brand name, used as the "Powered by …"
# label on branded emails for non-white_label tenants. Override to resell the
# platform itself under a different name. Defaults to "Eynis".
PLATFORM_BRAND_NAME="Eynis"

# AI providers (optional — keyword fallback is used when both are unset)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Webhook signature verification — enforced AUTOMATICALLY once a provider's
# verification config exists (INTERAKT_WEBHOOK_SECRET, or TWILIO_AUTH_TOKEN plus
# TWILIO_WEBHOOK_URL/EYNIS_PUBLIC_URL). VERIFY_WEBHOOKS is an override: "true"
# forces enforcement even when half-configured, "false" explicitly disables it
# (dev escape hatch), unset = auto.
VERIFY_WEBHOOKS=""
# Trust the first x-forwarded-for hop for rate-limit keys. Default "true"
# (correct behind Render/nginx); set "false" when the API is exposed directly
# so callers cannot rotate limiter keys via a forged header.
TRUST_PROXY=""
WHATSAPP_WEBHOOK_SECRET=""
INTERAKT_WEBHOOK_SECRET=""
# The exact public URL Twilio POSTs to — its HMAC covers this URL, so inbound
# Twilio verification activates (and only works) when this is set correctly.
TWILIO_WEBHOOK_URL=""

# WhatsApp outbound — Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# WhatsApp outbound — Interakt
INTERAKT_API_KEY=""

# Public base URL of this API — used to build the Vapi webhook callback.
# REQUIRED to activate a voice campaign. Must be your real, trusted domain; the
# request Host header is never trusted for this (prevents callback exfiltration).
API_PUBLIC_URL=""

# Voice Campaign module — Vapi.ai telephony (leave blank for keyword/dev fallback)
VAPI_API_KEY=""
VAPI_PHONE_NUMBER_ID=""
VAPI_WEBHOOK_SECRET=""

# Voice Campaign module — Resend email follow-ups
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME=""

# Connector default availability (per-hotel overrides live in the DB)
CONNECTOR_WHATSAPP_INTERAKT_ENABLED="false"
CONNECTOR_WHATSAPP_TWILIO_ENABLED="false"
CONNECTOR_PMS_HOTELOGIX_ENABLED="false"
CONNECTOR_PMS_EZEE_ENABLED="false"
CONNECTOR_POS_PETPOOJA_ENABLED="false"
CONNECTOR_PAYMENTS_RAZORPAY_ENABLED="false"
CONNECTOR_VOICE_VAPI_ENABLED="false"
CONNECTOR_EMAIL_RESEND_ENABLED="false"

# Campaign engine tuning (sensible defaults; override for scale)
CSV_MAX_UPLOAD_MB="25"                  # max lead-import file size
CAMPAIGN_DISPATCH_BATCH="200"           # leads processed per channel per 30s tick
CAMPAIGN_DISPATCH_INTERVAL_MS="30000"   # dispatch worker cycle
# TRAI DND scrub for +91 VOICE is enforced by DEFAULT (fail closed): un-scrubbed
# Indian numbers are skipped until the Phase-2 registry connector lands. Set to
# "false" to bypass in dev or in regions where TRAI DND does not apply.
ENFORCE_DND_SCRUB="true"
