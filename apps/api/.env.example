# ─────────────────────────────────────────────────────────────────────────────
# @eynis/api environment
# Copy to apps/api/.env and fill in real values. .env is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Core
# PostgreSQL connection string (Render Postgres, Neon, Supabase, local, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
JWT_SECRET="replace-with-long-random-secret"
PORT="4000"
# Set START_SERVER=true to actually listen (tests import buildServer without it).
START_SERVER="true"
# Base URL of the web app — used to build invite links (POST /team/invitations).
EYNIS_WEB_BASE_URL="http://localhost:3000"

# AI providers (optional — keyword fallback is used when both are unset)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Webhook signature verification
VERIFY_WEBHOOKS="false"
WHATSAPP_WEBHOOK_SECRET=""
INTERAKT_WEBHOOK_SECRET=""

# WhatsApp outbound — Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# WhatsApp outbound — Interakt
INTERAKT_API_KEY=""

# Public base URL of this API — used to build the Vapi webhook callback.
# REQUIRED to activate a voice campaign. Must be your real, trusted domain; the
# request Host header is never trusted for this (prevents callback exfiltration).
API_PUBLIC_URL=""

# Voice Campaign module — Vapi.ai telephony (leave blank for keyword/dev fallback)
VAPI_API_KEY=""
VAPI_PHONE_NUMBER_ID=""
VAPI_WEBHOOK_SECRET=""

# Voice Campaign module — Resend email follow-ups
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME=""

# Connector default availability (per-hotel overrides live in the DB)
CONNECTOR_WHATSAPP_INTERAKT_ENABLED="false"
CONNECTOR_WHATSAPP_TWILIO_ENABLED="false"
CONNECTOR_PMS_HOTELOGIX_ENABLED="false"
CONNECTOR_PMS_EZEE_ENABLED="false"
CONNECTOR_POS_PETPOOJA_ENABLED="false"
CONNECTOR_PAYMENTS_RAZORPAY_ENABLED="false"
CONNECTOR_VOICE_VAPI_ENABLED="false"
CONNECTOR_EMAIL_RESEND_ENABLED="false"
