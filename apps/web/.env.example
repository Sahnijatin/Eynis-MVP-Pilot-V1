# ─────────────────────────────────────────────────────────────────────────────
# @eynis/web environment
# Copy to apps/web/.env.local and fill in real values. .env.local is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# API connection
EYNIS_API_BASE_URL="http://localhost:4000"
# Optional: a static API token. If set, the web skips the /auth/token call.
EYNIS_API_TOKEN=""

# ── Demo / showcase hotel ────────────────────────────────────────────────────
# Credentials the web uses to authenticate against the demo hotel.
EYNIS_DEMO_HOTEL_ID="eynis-riviera-1"
EYNIS_DEMO_OWNER_EMAIL="vikram@theriviera.com"
EYNIS_DEMO_OWNER_ROLE="owner"
# Opt-in: serve the shared demo hotel's data to UNRESOLVED visitors (no DB user).
# Required "true" for the public demo (demo.eynis.com) to work for logged-out
# visitors. MUST stay unset/false in a real multi-tenant deployment — a resolved,
# logged-in user never falls back to the demo tenant regardless of this flag.
EYNIS_ALLOW_DEMO_FALLBACK="true"

# ── Clerk auth (required) ────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ── ElevenLabs voice (optional) ──────────────────────────────────────────────
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
