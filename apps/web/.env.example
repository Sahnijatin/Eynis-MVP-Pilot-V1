# ─────────────────────────────────────────────────────────────────────────────
# @eynis/web environment
# Copy to apps/web/.env.local and fill in real values. .env.local is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# API connection
EYNIS_API_BASE_URL="http://localhost:4000"
# Optional: a static API token. If set, the web skips the /auth/token call.
EYNIS_API_TOKEN=""

# ── Demo / showcase hotel ────────────────────────────────────────────────────
# Credentials the web uses to authenticate against the demo hotel.
EYNIS_DEMO_HOTEL_ID="eynis-riviera-1"
EYNIS_DEMO_OWNER_EMAIL="vikram@theriviera.com"
EYNIS_DEMO_OWNER_ROLE="owner"
# Opt-in: serve the shared demo hotel's data to UNRESOLVED visitors (no DB user),
# and let the public /request form fall back to the demo tenant. Set "true" ONLY
# for the public demo (demo.eynis.com); leave "false" in a real multi-tenant
# deployment so no unresolved visitor or param-less request lands in the demo
# tenant. A resolved, logged-in user never falls back to demo regardless.
EYNIS_ALLOW_DEMO_FALLBACK="false"

# ── Internal provisioning console (E-8) ──────────────────────────────────────
# Staff-only super-admin secret (16+ chars). Must match the API's
# PLATFORM_ADMIN_SECRET. Gates /admin/provisioning, where Eynis staff set a
# tenant's industry. Leave unset to disable the console entirely (fail closed).
PLATFORM_ADMIN_SECRET=""

# ── Clerk auth (required) ────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ── ElevenLabs voice (optional) ──────────────────────────────────────────────
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# Shared web<->API secret for the identity boundary (Phase 9 / C1). Sent as the
# x-token-exchange-secret header on /auth/token + /auth/identify calls; must
# match the API's EYNIS_TOKEN_EXCHANGE_SECRET. Unset in dev keeps things open.
EYNIS_TOKEN_EXCHANGE_SECRET=""
