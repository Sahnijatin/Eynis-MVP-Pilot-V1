{
  "$comment": "Machine-readable old->new color mapping for the Phase 6 codemod. Keys are exact Tailwind color utilities (without state/variant prefixes like hover: or md:, which the codemod preserves). Values are the target semantic token. 'var(--token)' means replace the utility with an arbitrary-value class or inline var. Entries marked manual:true must NOT be auto-rewritten. See migration-map.md for rationale.",
  "version": 0,
  "targetStyle": "css-var",
  "neutrals": {
    "text-slate-900": "--text",
    "text-slate-800": "--text",
    "text-gray-900": "--text",
    "text-slate-700": "--text",
    "text-slate-600": "--text-muted",
    "text-slate-500": "--text-muted",
    "text-gray-500": "--text-muted",
    "text-slate-400": "--text-subtle",
    "text-slate-300": "--text-faint",
    "text-slate-200": "--text-faint",
    "bg-white": "--surface",
    "bg-slate-50": "--surface-inset",
    "bg-slate-100": "--surface-inset",
    "bg-slate-200": "--surface-inset",
    "border-slate-50": "--border",
    "border-slate-100": "--border",
    "border-slate-200": "--border",
    "border-slate-300": "--border-strong"
  },
  "accent": {
    "bg-teal-700": "--accent-solid",
    "bg-teal-600": "--accent-solid",
    "bg-teal-50": "--accent-bg",
    "text-teal-700": "--accent-text",
    "text-teal-600": "--accent-text",
    "border-teal-200": "--accent-line",
    "border-teal-300": "--accent-border",
    "ring-teal-500": "--ring"
  },
  "status": {
    "text-red-800": "--danger-text",
    "text-red-700": "--danger-text",
    "text-red-600": "--danger-text",
    "text-red-500": "--danger-text",
    "text-red-400": "--danger-text",
    "bg-red-50": "--danger-bg",
    "border-red-100": "--danger-border",
    "border-red-200": "--danger-border",
    "text-amber-800": "--warn-text",
    "text-amber-700": "--warn-text",
    "text-amber-600": "--warn-text",
    "text-amber-500": "--warn-text",
    "text-amber-400": "--warn-text",
    "bg-amber-50": "--warn-bg",
    "bg-amber-400": "--warn-solid",
    "bg-amber-500": "--warn-solid",
    "border-amber-100": "--warn-border",
    "border-amber-200": "--warn-border",
    "text-emerald-700": "--ok-text",
    "text-emerald-600": "--ok-text",
    "text-emerald-500": "--ok-text",
    "text-emerald-400": "--ok-text",
    "bg-emerald-50": "--ok-bg",
    "bg-emerald-500": "--ok-solid",
    "text-blue-600": "--info-text",
    "text-blue-400": "--info-text",
    "bg-blue-50": "--info-bg"
  },
  "categorical": {
    "$comment": "manual: route to --cat-* palette in Phase 7, NOT auto-rewritten",
    "ring-cyan-400": { "token": "--cat-1", "manual": true },
    "ring-purple-400": { "token": "--cat-2", "manual": true },
    "ring-orange-400": { "token": "--cat-3", "manual": true },
    "text-purple-600": { "token": "--cat-2", "manual": true }
  },
  "hex": {
    "$comment": "Buckets for the ~642 raw hex values; handled per-bucket, mostly outside the class codemod.",
    "tokenFallbackDuplicate": { "pattern": "var\\(--color-[a-z-]+,\\s*#[0-9a-fA-F]{3,6}\\)", "action": "drop-fallback" },
    "dsTokensPalette": { "file": "components/ds/tokens.ts", "action": "rewrite-to-css-vars", "phase": 4 },
    "industryBrandHues": { "file": "lib/industry-config.ts", "action": "keep", "reason": "ramp input, not style" },
    "decorative": { "action": "manual", "phase": [4, 7] }
  },
  "keep": [
    "lib/industry-config.ts:accentColor",
    "lib/theme.ts",
    "lib/platform.ts",
    "docs/**"
  ]
}
